{
  "name": "vikisize",
  "version": "0.1.0",
  "private": true,
  "description": "VikiSize application repository",
  "scripts": {
    "build:cloudfunctions": "node scripts/build-cloudfunctions.js",
    "build:travel-previews": "node scripts/travel-templates/build-h5.js",
    "build:travel-seed": "node scripts/travel-templates/build-miniprogram-seed.js",
    "deploy:wechat": "node scripts/upload-wechat.js",
    "lint": "eslint .",
    "migrate:travel-template": "node scripts/travel-templates/migrate-legacy.js",
    "pretest": "npm run build:cloudfunctions && npm run build:travel-previews",
    "test": "node --test scripts/tests/*.test.js",
    "test:cloudfunctions": "npm run build:cloudfunctions && node --test scripts/tests/cloudfunctions-security.test.js",
    "test:domain": "node --test scripts/tests/domain.test.js",
    "test:travel-editor": "node --test scripts/tests/travel-editor.test.js",
    "test:travel-map-today": "node --test scripts/tests/travel-map-today.test.js",
    "test:travel-collaboration": "node --test scripts/tests/travel-collaboration.test.js",
    "test:travel-browse": "node --test scripts/tests/travel-template-browse.test.js",
    "test:travel-templates": "npm run build:travel-previews && node --test scripts/tests/travel-templates.test.js",
    "validate:travel-templates": "node scripts/travel-templates/validate.js",
    "validate:wechat": "node scripts/validate-miniprogram.js"
  },
  "devDependencies": {
    "eslint": "10.7.0",
    "miniprogram-ci": "2.1.31"
  }
}
