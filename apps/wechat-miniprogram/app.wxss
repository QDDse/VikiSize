page {
  min-height: 100vh;
  background: #f3f8f6;
  color: #16342d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 40rpx 80rpx;
}

button::after {
  border: 0;
}

button {
  transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.2, 1), transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

button:active,
.service-card:active,
.list-card:active,
.report-card:active {
  opacity: 0.88;
  transform: scale(0.985);
}

.topbar {
  align-items: center;
  display: flex;
  height: 116rpx;
  justify-content: space-between;
}

.page-title {
  color: #16342d;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1;
}

.top-action {
  background: transparent;
  border: 0;
  color: #267d69;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.space-header {
  background: linear-gradient(145deg, #153b32 0%, #275348 100%);
  border-radius: 40rpx;
  box-sizing: border-box;
  color: #ffffff;
  margin-top: 0;
  min-height: 312rpx;
  overflow: hidden;
  padding: 40rpx;
  position: relative;
}

.space-header::after {
  background: rgba(105, 214, 179, 0.2);
  border-radius: 50%;
  content: "";
  height: 220rpx;
  position: absolute;
  right: -76rpx;
  top: -82rpx;
  width: 220rpx;
}

.space-kicker {
  color: #c6e6dc;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  position: relative;
  text-transform: uppercase;
  z-index: 1;
}

.space-title-row {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

.space-title {
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.18;
}

.space-role {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  color: #ffffff;
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 900;
  padding: 10rpx 18rpx;
}

.space-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

.link-button {
  background: rgba(255, 255, 255, 0.14);
  border: 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 64rpx;
  margin: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
}

.hero-copy {
  color: #c6e6dc;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.55;
  margin-top: 20rpx;
  position: relative;
  z-index: 1;
}

.search-box {
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  box-sizing: border-box;
  color: #8a96a8;
  display: flex;
  font-size: 26rpx;
  font-weight: 700;
  gap: 16rpx;
  height: 88rpx;
  padding: 0 28rpx;
}

.search-dot {
  background: #cbd4df;
  border-radius: 50%;
  height: 28rpx;
  width: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #153b32 0%, #275348 100%);
  border-radius: 40rpx;
  box-sizing: border-box;
  color: #ffffff;
  margin-top: 28rpx;
  min-height: 300rpx;
  padding: 36rpx;
}

.hero-title {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.16;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.pill-button,
.ghost-button {
  border: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #ffffff;
  flex: 0 0 auto;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 76rpx;
  margin: 0;
  min-height: 76rpx;
  padding: 0 30rpx;
}

.pill-button {
  background: #2b8a75;
}

.ghost-button {
  background: #e8f2ee;
  color: #31594e;
}

.section {
  margin-top: 36rpx;
}

.section-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #16342d;
  font-size: 32rpx;
  font-weight: 800;
}

.section-note {
  color: #64746e;
  font-size: 24rpx;
  font-weight: 700;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 14rpx 32rpx rgba(21, 65, 55, 0.06);
  box-sizing: border-box;
  padding: 32rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.list-card {
  background: #ffffff;
  border-radius: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 28rpx rgba(21, 65, 55, 0.05);
  padding: 26rpx;
}

.service-card {
  align-items: center;
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(21, 65, 55, 0.05);
  box-sizing: border-box;
  display: flex;
  gap: 24rpx;
  min-height: 152rpx;
  padding: 28rpx;
}

.service-main {
  flex: 1;
  min-width: 0;
}

.list-row {
  align-items: center;
  display: flex;
  gap: 20rpx;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.badge {
  background: #dff2ea;
  border-radius: 999rpx;
  color: #246e5d;
  display: inline-flex;
  font-size: 22rpx;
  font-weight: 900;
  padding: 8rpx 16rpx;
}

.badge.soft {
  background: #edf3f0;
  color: #536861;
}

.muted {
  color: #64746e;
}

.empty {
  background: #ffffff;
  border-radius: 30rpx;
  color: #64746e;
  font-size: 26rpx;
  font-weight: 700;
  padding: 34rpx;
  text-align: center;
}

.space-header .ghost-button,
.detail-hero .ghost-button {
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

.segmented {
  background: #e6efeb;
  border-radius: 30rpx;
  display: flex;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 8rpx;
}

.segment {
  border-radius: 22rpx;
  color: #64746e;
  flex: 1;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
}

.segment.active {
  background: #1f6758;
  color: #ffffff;
}

.card-title {
  color: #16342d;
  font-size: 32rpx;
  font-weight: 900;
  margin-bottom: 22rpx;
}

.row {
  align-items: center;
  display: flex;
}

.column {
  display: flex;
  flex-direction: column;
}

.soft-blue {
  background: #e3f1ec;
}

.soft-green {
  background: #e3f1ec;
}

.soft-amber {
  background: #f4f0e7;
}

.soft-violet {
  background: #edf3f0;
}

.icon-box,
.thumb,
.service-icon,
.menu-icon,
.avatar {
  align-items: center;
  background: #e3f1ec;
  border-radius: 24rpx;
  color: #246e5d;
  display: flex;
  font-size: 22rpx;
  font-weight: 800;
  flex: 0 0 auto;
  height: 88rpx;
  justify-content: center;
  width: 88rpx;
}

.icon-box {
  align-items: center;
  color: #ffffff;
  display: flex;
  font-size: 28rpx;
  font-weight: 800;
  justify-content: center;
}

.icon-brand {
  background: #2b8a75;
}

.item-title {
  color: #16342d;
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.item-subtitle {
  color: #64746e;
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 8rpx;
}

.chevron {
  color: #8a9893;
  font-size: 34rpx;
  font-weight: 800;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
  overflow: hidden;
}

.chip {
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #d8e8e1;
  border-radius: 999rpx;
  color: #536861;
  display: flex;
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 900;
  height: 64rpx;
  padding: 0 24rpx;
}

.chip.active {
  background: #dff2ea;
  border-color: #88cdb9;
  color: #246e5d;
}

.shortcut-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.shortcut-card {
  background: #ffffff;
  border-radius: 30rpx;
  box-sizing: border-box;
  flex: 1;
  min-height: 180rpx;
  padding: 24rpx;
}

.shortcut-mark {
  background: #2b8a75;
  border-radius: 18rpx;
  height: 56rpx;
  width: 56rpx;
}

.shortcut-title {
  color: #16342d;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
  margin-top: 18rpx;
}

.shortcut-detail {
  color: #64746e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 8rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-row {
  align-items: center;
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
