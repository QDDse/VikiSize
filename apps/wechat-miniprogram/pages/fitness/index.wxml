<view class="page fitness-page">
  <view class="topbar fitness-topbar">
    <view class="title-cluster">
      <view class="page-title">健身</view>
      <view class="page-subtitle">训练回顾</view>
    </view>
    <view class="top-action" role="button" bindtap="createPipelineChannel">
      <text>接入数据</text>
      <image class="top-action-icon" src="/assets/icons/link.png" mode="aspectFit" />
    </view>
  </view>

  <view class="notice" wx:if="{{cloudWarning}}">{{cloudWarning}}</view>
  <view class="notice error" wx:if="{{loadError}}">{{loadError}}</view>

  <view class="weekly-summary">
    <view class="weekly-kicker">本周回顾 · {{weekRangeText}}</view>
    <view class="weekly-title">{{weeklyStatusTitle}}</view>
    <view class="weekly-copy">{{weeklyStatusCopy}}</view>
    <view class="weekly-link" wx:if="{{deliveries.length}}" bindtap="openActiveDelivery"><text>查看训练记录</text><image class="weekly-chevron" src="/assets/icons/chevron.png" mode="aspectFit" /></view>
    <view class="weekly-link" wx:else bindtap="createPipelineChannel"><text>开始接入</text><image class="weekly-chevron" src="/assets/icons/chevron.png" mode="aspectFit" /></view>
  </view>

  <view class="fitness-ledger">
    <view class="fitness-ledger-item">
      <text>周报</text>
      <text class="fitness-ledger-value">{{deliveries.length}}</text>
      <text>份</text>
    </view>
    <view class="fitness-ledger-divider"></view>
    <view class="fitness-ledger-item">
      <text>待确认</text>
      <text class="fitness-ledger-value">{{pendingCount}}</text>
      <text>项</text>
    </view>
    <view class="fitness-ledger-divider"></view>
    <view class="fitness-ledger-item">
      <text>体测</text>
      <text class="fitness-ledger-value">{{measurementCount}}</text>
      <text>份</text>
    </view>
  </view>

  <view class="fitness-section">
    <view class="fitness-section-head">
      <view class="fitness-section-title">最近体测</view>
      <view class="fitness-section-action" bindtap="openBodyImport">导入</view>
    </view>
    <view class="fitness-group">
      <view class="fitness-row" bindtap="openBodyImport">
        <image class="row-leading-icon" src="/assets/icons/document.png" mode="aspectFit" />
        <view class="fitness-row-main" wx:if="{{latestMeasurement}}">
          <view class="fitness-row-title">{{latestMeasurement.measuredDisplayDate}}体测记录</view>
          <view class="fitness-row-meta">原始报告已保留</view>
        </view>
        <view class="fitness-row-main" wx:else>
          <view class="fitness-row-title">还没有体测记录</view>
          <view class="fitness-row-meta">导入第一份报告图</view>
        </view>
        <view class="fitness-row-side">{{measurementCount}} 份</view>
        <image class="row-chevron" src="/assets/icons/chevron.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <view class="fitness-section reminder-section">
    <view class="fitness-section-head">
      <view class="fitness-section-title">提醒</view>
    </view>
    <view class="fitness-group">
      <view class="fitness-row reminder-row">
        <image class="row-leading-icon" src="/assets/icons/reminder.png" mode="aspectFit" />
        <view class="fitness-row-main">
          <view class="fitness-row-title">下一个周报提醒</view>
          <view class="fitness-row-meta">周日 20:00</view>
          <view class="fitness-row-helper">{{reminderNote}}</view>
        </view>
        <switch class="reminder-switch" checked="{{notificationStatus === 'granted'}}" disabled="{{notificationStatus === 'granted'}}" color="#267d69" bindchange="toggleWeeklyReminder" />
      </view>
    </view>
  </view>

  <view class="fitness-section report-section">
    <view class="fitness-section-head">
      <view class="fitness-section-title">周报归档</view>
      <view class="fitness-section-note">{{unreadCount ? unreadCount + ' 份未读' : '已读完'}}</view>
    </view>

    <view class="fitness-group report-list" wx:if="{{deliveries.length}}">
      <view class="report-row" wx:for="{{deliveries}}" wx:key="deliveryId" data-id="{{item.deliveryId}}" bindtap="openDelivery">
        <view class="fitness-row-main">
          <view class="report-date">{{item.archiveDate}} · {{item.archiveWeekday}}</view>
          <view class="fitness-row-title report-title">{{item.archiveTitle}}</view>
        </view>
        <view class="report-side">
          <view class="report-status {{item.readAt ? '' : 'unread'}}">{{item.readAt ? '已读' : item.decisionText}}</view>
          <image class="row-chevron" src="/assets/icons/chevron.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="fitness-empty" wx:else>
      <view class="fitness-row-title">这里会保存你的周报</view>
      <view class="fitness-row-meta">接入数据后，训练回顾和需要确认的变更会按时间留在这里。</view>
      <view class="fitness-empty-action" bindtap="createPipelineChannel">开始接入</view>
    </view>
  </view>
</view>
