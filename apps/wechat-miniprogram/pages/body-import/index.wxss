.import-page { padding-bottom: 100rpx; }
.import-hero { background: linear-gradient(145deg, #153b32 0%, #275348 100%); border-radius: 40rpx; box-shadow: 0 18rpx 36rpx rgba(21,65,55,.14); color: #fff; padding: 40rpx; }
.fitness-kicker { color: #a9e4d2; font-size: 22rpx; font-weight: 800; }
.import-title { font-size: 40rpx; font-weight: 800; line-height: 1.22; margin-top: 14rpx; }
.import-copy { color: #c6e6dc; font-size: 24rpx; line-height: 1.62; margin-top: 16rpx; }
.upload-box { align-items: center; background: #fff; border: 2rpx dashed #afd8c9; border-radius: 30rpx; display: flex; flex-direction: column; height: 320rpx; justify-content: center; margin-top: 20rpx; overflow: hidden; }
.upload-box image { height: 100%; width: 100%; }
.upload-plus { color: #2b8a75; font-size: 58rpx; font-weight: 300; }
.form-card { background: #fff; border-radius: 30rpx; box-shadow: 0 14rpx 32rpx rgba(21,65,55,.05); padding: 30rpx; }
.form-row { align-items: center; border-bottom: 1rpx solid #e3ece7; display: flex; justify-content: space-between; min-height: 100rpx; }
.form-label { color: #16342d; font-size: 26rpx; font-weight: 800; }
.form-input, .input-wrap { color: #1f705f; font-size: 26rpx; font-weight: 800; }
.input-wrap { align-items: center; display: flex; gap: 10rpx; }
.input-wrap input { text-align: right; width: 190rpx; }
.submit-button { background: #1f705f; border-radius: 999rpx; color: #fff; font-size: 27rpx; font-weight: 800; margin-top: 32rpx; }
