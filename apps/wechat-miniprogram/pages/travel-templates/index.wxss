.template-list { display: grid; gap: 20rpx; }
.template-card { background: #fff; border-radius: 32rpx; box-shadow: 0 14rpx 32rpx rgba(21,65,55,.06); overflow: hidden; }
.template-cover { background: #dce8e3; display: block; height: 330rpx; width: 100%; }
.template-body { padding: 28rpx; }
.template-desc { display: -webkit-box; line-height: 1.55; margin: 12rpx 0 18rpx; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
