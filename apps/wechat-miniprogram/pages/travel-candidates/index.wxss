.candidate-page { padding-bottom: 170rpx; }
.page-subtitle { color: #7a837f; font-size: 21rpx; margin-top: 9rpx; }
.add-place-action { background: #e8f2ed; border-radius: 999rpx; color: #176b4e; line-height: 60rpx; min-height: 60rpx; padding: 0 24rpx; }
.candidate-form { background: #fff; border-radius: 30rpx; box-shadow: 0 12rpx 34rpx rgba(36,61,51,.06); padding: 30rpx; }
.form-title { color: #25322d; font-size: 30rpx; font-weight: 900; margin-bottom: 22rpx; }
.field-label { color: #69736e; font-size: 21rpx; font-weight: 800; margin: 22rpx 0 10rpx; }
.field-input { background: #f0f3f1; border-radius: 18rpx; box-sizing: border-box; color: #25322d; font-size: 27rpx; height: 82rpx; padding: 0 22rpx; width: 100%; }
.location-picker { align-items: center; background: #f0f3f1; border: 2rpx solid transparent; border-radius: 20rpx; color: #25322d; display: flex; gap: 18rpx; margin: 18rpx 0 0; min-height: 110rpx; padding: 18rpx 20rpx; text-align: left; width: 100%; }
.location-picker.selected { background: #e8f2ed; border-color: #9dbdad; }
.location-pin { background: #2f8a65; border-radius: 50% 50% 50% 5rpx; flex: 0 0 auto; height: 34rpx; transform: rotate(-45deg); width: 34rpx; }
.location-picker-main { flex: 1; min-width: 0; }
.location-picker-title { font-size: 24rpx; font-weight: 900; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.location-picker-copy { color: #78817d; font-size: 19rpx; line-height: 1.4; margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.location-picker-arrow { color: #829088; font-size: 38rpx; }
.category-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.category-chip { background: #f0f3f1; border: 2rpx solid transparent; border-radius: 999rpx; color: #606a65; font-size: 21rpx; font-weight: 800; padding: 12rpx 20rpx; }
.category-chip.active { background: #e8f2ed; border-color: #79a993; color: #176b4e; }
.save-place { background: #176b4e; border-radius: 20rpx; color: #fff; font-size: 25rpx; font-weight: 900; line-height: 82rpx; margin-top: 28rpx; min-height: 82rpx; width: 100%; }
.candidate-toolbar { align-items: center; display: flex; gap: 18rpx; justify-content: space-between; margin-top: 28rpx; }
.candidate-switch { background: #e9edeb; border-radius: 18rpx; display: flex; flex: 1; padding: 5rpx; }
.candidate-filter { border-radius: 14rpx; color: #727b77; flex: 1; font-size: 22rpx; font-weight: 800; line-height: 58rpx; text-align: center; }
.candidate-filter.active { background: #fff; box-shadow: 0 5rpx 14rpx rgba(32,65,53,.08); color: #193d32; }
.select-action { background: transparent; color: #176b4e; font-size: 22rpx; font-weight: 900; line-height: 60rpx; margin: 0; min-height: 60rpx; padding: 0 8rpx; }
.candidate-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 20rpx; }
.candidate-card { align-items: center; background: #fff; border: 2rpx solid transparent; border-radius: 26rpx; display: flex; gap: 18rpx; min-height: 128rpx; padding: 23rpx; transition: border-color 160ms ease, transform 160ms ease; }
.candidate-card.selected { background: #f3f8f5; border-color: #79a993; transform: translateX(4rpx); }
.select-mark { align-items: center; border: 2rpx solid #8eaaa0; border-radius: 50%; color: #fff; display: flex; flex: 0 0 auto; font-size: 18rpx; font-weight: 900; height: 36rpx; justify-content: center; width: 36rpx; }
.candidate-card.selected .select-mark { background: #176b4e; border-color: #176b4e; }
.candidate-index { align-items: center; background: #e8f2ed; border-radius: 14rpx; color: #176b4e; display: flex; flex: 0 0 auto; font-size: 22rpx; font-weight: 900; height: 54rpx; justify-content: center; width: 54rpx; }
.candidate-main { flex: 1; min-width: 0; }
.candidate-title { color: #25322d; font-size: 27rpx; font-weight: 900; }
.candidate-location { color: #727b77; font-size: 21rpx; margin-top: 7rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.candidate-meta { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 12rpx; }
.candidate-tag { background: #eef2f0; border-radius: 7rpx; color: #64706a; font-size: 18rpx; padding: 6rpx 10rpx; }
.candidate-tag.arranged { background: #e8f2ed; color: #176b4e; }
.candidate-tag.missing { background: #fff0df; color: #995513; }
.candidate-more { background: #e8f2ed; border-radius: 999rpx; color: #176b4e; flex: 0 0 auto; font-size: 20rpx; font-weight: 900; line-height: 54rpx; margin: 0; min-height: 54rpx; padding: 0 20rpx; }
.candidate-more.muted-action { background: #eef1ef; color: #6c7571; }
.candidate-empty { align-items: center; background: #fff; border-radius: 28rpx; display: flex; flex-direction: column; margin-top: 24rpx; padding: 70rpx 50rpx; text-align: center; }
.empty-orbit { border: 3rpx solid #b7cbc1; border-radius: 50%; height: 76rpx; margin-bottom: 27rpx; position: relative; width: 76rpx; }
.empty-orbit-dot { background: #2f8a65; border-radius: 50%; height: 20rpx; position: absolute; right: 1rpx; top: 4rpx; width: 20rpx; }
.empty-title { color: #25322d; font-size: 29rpx; font-weight: 900; }
.empty-copy { color: #737c78; font-size: 22rpx; line-height: 1.55; margin-top: 12rpx; }
.empty-button { background: #e8f2ed; border-radius: 999rpx; color: #176b4e; font-size: 23rpx; font-weight: 900; line-height: 68rpx; margin-top: 28rpx; min-height: 68rpx; padding: 0 28rpx; }
.batch-dock { align-items: center; background: rgba(25,61,50,.97); bottom: 0; display: flex; justify-content: space-between; left: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); position: fixed; right: 0; z-index: 10; }
.batch-count { color: #d6e9e0; font-size: 23rpx; font-weight: 800; }
.batch-button { background: #fff; border-radius: 18rpx; color: #176b4e; font-size: 23rpx; font-weight: 900; line-height: 70rpx; margin: 0; min-height: 70rpx; padding: 0 28rpx; }
