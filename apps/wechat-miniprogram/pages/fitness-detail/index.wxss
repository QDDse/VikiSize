.detail-page { padding-bottom: 112rpx; }
.report-hero { background: linear-gradient(145deg, #153b32 0%, #275348 100%); border-radius: 40rpx; box-shadow: 0 18rpx 36rpx rgba(21,65,55,.14); color: #fff; padding: 40rpx; }
.fitness-kicker { color: #a9e4d2; font-size: 22rpx; font-weight: 800; letter-spacing: 1rpx; }
.report-title { font-size: 40rpx; font-weight: 800; line-height: 1.3; margin-top: 16rpx; }
.hash-label { color: #b9d8ce; font-size: 19rpx; margin-top: 18rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.metric-grid { display: grid; gap: 18rpx; grid-template-columns: 1fr 1fr; margin-top: 24rpx; }
.metric-card { background: #fff; border-radius: 28rpx; box-shadow: 0 12rpx 28rpx rgba(21,65,55,.05); padding: 26rpx; }
.metric-label { color: #64746e; font-size: 22rpx; font-weight: 700; }
.metric-value { color: #16342d; font-size: 42rpx; font-variant-numeric: tabular-nums; font-weight: 800; }
.metric-unit { color: #64746e; font-size: 20rpx; margin-left: 6rpx; }
.insight { align-items: flex-start; background: #fff; border-radius: 28rpx; box-shadow: 0 10rpx 26rpx rgba(21,65,55,.04); display: flex; font-size: 26rpx; gap: 16rpx; line-height: 1.6; margin-top: 16rpx; padding: 24rpx; }
.insight-dot { background: #2b8a75; border-radius: 50%; flex: 0 0 auto; height: 12rpx; margin-top: 14rpx; width: 12rpx; }
.insight-index { align-items: center; background: #dff2ea; border-radius: 50%; color: #246e5d; display: flex; flex: 0 0 auto; font-size: 20rpx; font-weight: 800; height: 38rpx; justify-content: center; width: 38rpx; }
.diff-card { background: #fff; border-radius: 28rpx; box-shadow: 0 10rpx 26rpx rgba(21,65,55,.04); margin-top: 18rpx; padding: 26rpx; }
.diff-target { color: #16342d; font-size: 27rpx; font-weight: 800; }
.diff-values { display: grid; gap: 14rpx; grid-template-columns: 1fr 1fr; margin: 20rpx 0 14rpx; }
.before, .after { border-radius: 18rpx; font-size: 24rpx; font-weight: 700; padding: 18rpx; }
.before { background: #fee2e2; color: #991b1b; }
.after { background: #dff2ea; color: #246e5d; }
.writeback-card { background: #f0f8f5; border: 1rpx solid #d3eade; border-radius: 28rpx; margin-top: 20rpx; padding: 26rpx; }
.writeback-note { color: #536861; font-size: 21rpx; line-height: 1.55; margin-top: 8rpx; }
.writeback-row { border-top: 1rpx solid #d8e8e1; font-size: 23rpx; margin-top: 16rpx; padding-top: 16rpx; }
.writeback-value { color: #246e5d; font-weight: 800; margin-top: 6rpx; }
.decision-actions { display: flex; gap: 18rpx; margin-top: 30rpx; }
.decision-actions button { border-radius: 999rpx; flex: 1; font-size: 25rpx; font-weight: 800; }
.reject-button { background: #e8efec; color: #465d55; }
.accept-button { background: #1f705f; color: #fff; }
.decision-result { background: #dff2ea; border-radius: 24rpx; color: #246e5d; font-size: 26rpx; font-weight: 800; margin-top: 24rpx; padding: 22rpx; text-align: center; }
.notice.error { background: #fee2e2; border-radius: 22rpx; color: #991b1b; padding: 18rpx; }
