<view class="page detail-page">
  <view class="notice error" wx:if="{{loadError}}">{{loadError}}</view>
  <block wx:if="{{delivery}}">
    <view class="report-hero">
      <view class="fitness-kicker">{{delivery.report.period.start}} — {{delivery.report.period.end}}</view>
      <view class="report-title">{{delivery.report.summary}}</view>
      <view class="hash-label">报告 {{delivery.report.reportId}}</view>
    </view>

    <view class="metric-grid">
      <view class="metric-card" wx:for="{{delivery.report.metrics}}" wx:key="key">
        <view class="metric-label">{{item.label}}</view>
        <view><text class="metric-value">{{item.value}}</text><text class="metric-unit">{{item.unit}}</text></view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">关键洞察</view>
      <view class="insight" wx:for="{{delivery.report.insights}}" wx:key="*this"><view class="insight-dot"></view>{{item}}</view>
    </view>

    <view class="section">
      <view class="section-title">行动建议</view>
      <view class="insight recommendation" wx:for="{{delivery.report.recommendations}}" wx:key="*this"><view class="insight-index">{{index + 1}}</view>{{item}}</view>
    </view>

    <view class="section patch-section" wx:if="{{delivery.planPatch}}">
      <view class="section-head">
        <view class="section-title">下周计划 Diff</view>
        <view class="section-note">基于 {{delivery.planPatch.basePlanVersion}}</view>
      </view>
      <view class="diff-card" wx:for="{{delivery.planPatch.changes}}" wx:key="target">
        <view class="diff-target">{{item.title || item.target}}</view>
        <view class="diff-values">
          <view class="before">− {{item.before}}</view>
          <view class="after">＋ {{item.after}}</view>
        </view>
        <view class="item-subtitle">原因：{{item.reason}}</view>
      </view>
      <view class="writeback-card" wx:if="{{delivery.planPatch.writeback}}">
        <view class="diff-target">采纳后写回训记训练记录</view>
        <view class="writeback-note">以下摘要与 Patch 哈希绑定，点击采纳即确认这些变更。</view>
        <view class="writeback-row" wx:for="{{delivery.planPatch.writeback.summary}}" wx:key="label">
          <view>{{item.datestr}} · {{item.label}}</view>
          <view class="writeback-value">{{item.before === null ? '新建' : item.before}} → {{item.after}}{{item.unit || ''}}</view>
        </view>
      </view>
      <view class="hash-label">Patch: {{delivery.planPatch.patchHash}}</view>
      <view class="decision-result" wx:if="{{decisionText}}">{{decisionText}}</view>
      <view class="decision-actions" wx:else>
        <button class="reject-button" bindtap="rejectPatch">拒绝</button>
        <button class="accept-button" bindtap="acceptPatch">{{delivery.planPatch.writeback ? '采纳并写回训记' : '采纳计划'}}</button>
      </view>
    </view>
  </block>
</view>
