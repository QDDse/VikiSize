<view class="page plans-page">
  <view class="topbar plans-topbar">
    <view class="page-title">旅行</view>
    <view class="top-action" role="button" bindtap="openSettings">
      <image class="top-action-icon" src="/assets/icons/members.png" mode="aspectFit" />
      <text>成员</text>
    </view>
  </view>

  <view class="trip-summary" wx:if="{{instance}}" role="button" bindtap="openSpaces">
    <view class="trip-kicker" wx:if="{{summary.travelState === 'before'}}"><image class="trip-kicker-icon" src="/assets/icons/calendar.png" mode="aspectFit" />距离出发 <text>{{summary.daysUntilStart}}</text> 天</view>
    <view class="trip-kicker" wx:elif="{{summary.travelState === 'during'}}">旅行进行中</view>
    <view class="trip-kicker" wx:else>旅行已结束</view>
    <view class="trip-title">{{context.space.name}}</view>
    <view class="trip-date">{{tripDateRange}}</view>
    <view class="trip-summary-foot">
      <view class="trip-role">{{roleLabel}}</view>
    </view>
  </view>

  <view class="trip-summary trip-summary-empty" wx:else>
    <view class="trip-kicker">旅行空间</view>
    <view class="trip-title">从一段真实行程开始</view>
    <view class="trip-date">创建空间或从模板复制行程</view>
    <view class="summary-link summary-link-empty" bindtap="openSpaces">选择旅行空间</view>
  </view>

  <view class="next-action" wx:if="{{instance}}">
    <view class="next-action-main">
      <view class="next-label">{{primaryAction.label}}</view>
      <view class="next-title">{{primaryAction.title}}</view>
      <view class="next-meta">{{primaryAction.meta}}</view>
    </view>
    <view class="next-button" role="button" bindtap="openPrimaryAction">
      <text>{{primaryAction.text}}</text>
      <image class="chevron-icon" src="/assets/icons/chevron.png" mode="aspectFit" />
    </view>
  </view>

    <view class="trip-ledger" wx:if="{{instance}}">
    <view class="ledger-item" role="button" data-tab="tasks" bindtap="setTab">
      <image class="ledger-icon" src="/assets/icons/tasks.png" mode="aspectFit" />
      <view class="ledger-label">任务</view>
      <view class="ledger-value">{{cards.length}}</view>
    </view>
    <view class="ledger-divider"></view>
    <view class="ledger-item" role="button" data-tab="budget" bindtap="setTab">
      <image class="ledger-icon" src="/assets/icons/wallet.png" mode="aspectFit" />
      <view class="ledger-label">预算</view>
      <view class="ledger-value">¥{{budgetDisplay}}</view>
    </view>
  </view>

  <view class="travel-section" wx:if="{{instance && tab === 'itinerary'}}">
    <view class="travel-section-head">
      <view class="travel-section-title">行程</view>
      <view class="travel-section-action" bindtap="openTravelPlan"><text>查看全部</text><image class="section-chevron" src="/assets/icons/chevron.png" mode="aspectFit" /></view>
    </view>
    <view class="grouped-list itinerary-list">
      <view class="itinerary-row" wx:for="{{previewDays}}" wx:key="id" bindtap="openTravelPlan">
        <view class="day-marker">D{{index + 1}}</view>
        <view class="row-main">
          <view class="row-meta">{{item.displayDate}} · {{item.weekday}}</view>
          <view class="row-title">{{item.theme}}</view>
          <view class="row-meta row-meta-bottom">{{item.nodes.length}} 个节点</view>
        </view>
        <image class="row-chevron" src="/assets/icons/chevron.png" mode="aspectFit" />
      </view>
    </view>
    <view class="travel-utility-links">
      <view data-tab="activity" bindtap="setTab">旅行动态</view>
      <view bindtap="openTravelTemplates">浏览模板</view>
    </view>
  </view>

  <view class="travel-section" wx:if="{{instance && tab === 'tasks'}}">
    <view class="travel-section-head">
      <view class="travel-section-title">任务</view>
      <view class="travel-section-actions">
        <view class="travel-section-back" data-tab="itinerary" bindtap="setTab">行程</view>
        <view class="travel-section-action" bindtap="createPlanCard">新任务</view>
      </view>
    </view>
    <view class="grouped-list" wx:if="{{cards.length}}">
      <view class="plain-row" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="openCard">
        <view class="row-main">
          <view class="row-title">{{item.title}}</view>
          <view class="row-meta row-meta-bottom">{{item.description}}</view>
        </view>
        <view class="row-status">{{item.statusLabel}}</view>
      </view>
    </view>
    <view class="quiet-empty" wx:else bindtap="createPlanCard">还没有任务，创建第一项</view>
  </view>

  <view class="travel-section" wx:if="{{instance && tab === 'budget'}}">
    <view class="travel-section-head">
      <view class="travel-section-title">预算</view>
      <view class="travel-section-actions">
        <view class="travel-section-back" data-tab="itinerary" bindtap="setTab">行程</view>
        <view class="travel-section-note">已确认 ¥{{budget.confirmedTotal}}</view>
      </view>
    </view>
    <view class="grouped-list">
      <view class="plain-row" wx:for="{{budget.categories}}" wx:key="id">
        <view class="row-main">
          <view class="row-title">{{item.name}}</view>
          <view class="row-meta row-meta-bottom">已确认 ¥{{item.confirmedCost}}</view>
        </view>
        <view class="row-status">预估 ¥{{item.estimatedCost}}</view>
      </view>
    </view>
  </view>

  <view class="travel-section" wx:if="{{instance && tab === 'activity'}}">
    <view class="travel-section-head">
      <view class="travel-section-title">动态</view>
      <view class="travel-section-actions">
        <view class="travel-section-back" data-tab="itinerary" bindtap="setTab">行程</view>
        <view class="travel-section-note">最近更新</view>
      </view>
    </view>
    <view class="grouped-list" wx:if="{{activities.length}}">
      <view class="plain-row" wx:for="{{activities}}" wx:key="id">
        <view class="row-main">
          <view class="row-title">{{item.summary}}</view>
          <view class="row-meta row-meta-bottom">{{item.createdAt}}</view>
        </view>
      </view>
    </view>
    <view class="quiet-empty" wx:else>还没有旅行动态</view>
  </view>
</view>
