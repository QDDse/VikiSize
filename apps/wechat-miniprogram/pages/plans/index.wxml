<view class="page">
  <view class="topbar">
    <view class="page-title">计划</view>
    <button plain="true" class="top-action" bindtap="openSettings">成员</button>
  </view>

  <view class="space-header plan-hero">
    <view class="space-kicker">正在规划</view>
    <view class="space-title-row">
      <view class="space-title">{{context.space.name}}</view>
      <view class="space-role">{{roleLabel}}</view>
    </view>
    <view class="hero-copy">把想去的地方、每天路线和同行任务整理成一份真正能执行的计划。</view>
    <view class="plan-stats">
      <view><text>{{planSummary.days}}</text><text>天</text></view>
      <view><text>{{planSummary.places}}</text><text>行程点</text></view>
      <view><text>{{planSummary.candidates}}</text><text>待安排</text></view>
    </view>
    <view class="space-actions">
      <button plain="true" class="link-button primary-link" bindtap="openTravelPlan">打开行程</button>
      <button plain="true" class="link-button" bindtap="openCandidates">地点库</button>
      <button plain="true" class="link-button" bindtap="createPlanCard">添加任务</button>
    </view>
  </view>

  <view class="segmented">
    <view class="segment {{tab === 'itinerary' ? 'active' : ''}}" data-tab="itinerary" bindtap="setTab">行程</view>
    <view class="segment {{tab === 'tasks' ? 'active' : ''}}" data-tab="tasks" bindtap="setTab">任务</view>
    <view class="segment {{tab === 'budget' ? 'active' : ''}}" data-tab="budget" bindtap="setTab">预算</view>
    <view class="segment {{tab === 'activity' ? 'active' : ''}}" data-tab="activity" bindtap="setTab">动态</view>
  </view>

  <view class="section" wx:if="{{tab === 'itinerary'}}">
    <view class="section-head">
      <view class="section-title">每天行程</view>
      <view class="section-note" bindtap="openTravelPlan">查看全部</view>
    </view>
    <view class="stack">
      <view class="service-card itinerary-day" wx:for="{{instance.days}}" wx:key="id" bindtap="openTravelPlan">
        <view class="day-number"><text>D{{index + 1}}</text><text>{{item.date}}</text></view>
        <view class="service-main">
          <view class="item-title">{{item.theme}}</view>
          <view class="item-subtitle">{{item.weekday}}　{{item.nodes.length}} 个地点</view>
        </view>
        <view class="day-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{tab === 'tasks'}}">
    <view class="section-head">
      <view class="section-title">任务卡片</view>
      <view class="section-note">{{cards.length}} 张</view>
    </view>
    <view class="stack">
      <view class="service-card" wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="openCard">
        <view class="service-icon small-icon">任</view>
        <view class="service-main">
          <view class="item-title">{{item.title}}</view>
          <view class="item-subtitle">{{item.description}}</view>
          <view class="meta-row">
            <view class="badge">{{item.statusLabel}}</view>
            <view class="badge soft" wx:if="{{item.estimateText}}">{{item.estimateText}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{tab === 'budget'}}">
    <view class="section-head">
      <view class="section-title">预算</view>
      <view class="section-note">预估 ¥{{budget.estimatedTotal}} / 已确认 ¥{{budget.confirmedTotal}}</view>
    </view>
    <view class="stack">
      <view class="service-card" wx:for="{{budget.categories}}" wx:key="id">
        <view class="service-icon small-icon">费</view>
        <view class="service-main">
          <view class="item-title">{{item.name}}</view>
          <view class="item-subtitle">已确认 ¥{{item.confirmedCost}}</view>
          <view class="meta-row">
            <view class="badge">预估 ¥{{item.estimatedCost}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{tab === 'activity'}}">
    <view class="section-head">
      <view class="section-title">活动</view>
      <view class="section-note">最近更新</view>
    </view>
    <view class="stack">
      <view class="service-card" wx:for="{{activities}}" wx:key="id">
        <view class="service-icon small-icon">记</view>
        <view class="service-main">
          <view class="item-title">{{item.summary}}</view>
          <view class="item-subtitle">{{item.createdAt}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
