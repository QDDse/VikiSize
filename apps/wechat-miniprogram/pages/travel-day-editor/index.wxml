<view class="page day-editor-page">
  <view class="topbar"><view><view class="page-title">{{dayId ? '编辑日期' : '新增日期'}}</view><view class="page-subtitle">为这一天设定主题和日期</view></view></view>
  <view class="editor-section"><view class="section-label">日期信息</view><view class="editor-card">
    <view class="field-label">日期</view><picker mode="date" value="{{form.date}}" bindchange="change" data-field="date"><view class="field-picker">{{form.date || '选择日期'}}<text>›</text></view></picker>
    <view class="field-label">星期</view><input class="field-input" value="{{form.weekday}}" data-field="weekday" bindinput="change" placeholder="例如：周一"/>
    <view class="field-label">当天主题</view><input class="field-input day-theme-input" value="{{form.theme}}" data-field="theme" bindinput="change" placeholder="例如：浅草与上野散步"/>
  </view></view>
  <button plain="true" class="delete-button" wx:if="{{dayId}}" bindtap="remove">删除这个日期</button>
  <view class="save-dock"><button plain="true" class="save-button" bindtap="save">{{dayId ? '保存修改' : '创建日期'}}</button></view>
</view>
