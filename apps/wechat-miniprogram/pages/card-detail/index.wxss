.detail-hero {
  background: linear-gradient(145deg, #153b32 0%, #275348 100%);
  border-radius: 40rpx;
  box-sizing: border-box;
  box-shadow: 0 18rpx 36rpx rgba(21, 65, 55, 0.14);
  color: #ffffff;
  padding: 40rpx;
}

.detail-hero .badge {
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

.hero-title {
  color: #ffffff;
  margin-top: 18rpx;
}

.hero-copy {
  color: #c6e6dc;
  margin-top: 14rpx;
}

.detail-actions {
  margin-top: 0;
}

.comment-box {
  background: #ffffff;
  border-radius: 28rpx;
  box-sizing: border-box;
  color: #16342d;
  font-size: 26rpx;
  min-height: 150rpx;
  padding: 24rpx;
  width: 100%;
}

.comment-button {
  margin-top: 16rpx;
  width: 100%;
}
