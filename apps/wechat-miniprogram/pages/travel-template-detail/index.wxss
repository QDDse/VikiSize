.detail-cover { background: #dce8e3; border-radius: 32rpx; display: block; height: 430rpx; width: 100%; }
.detail-hero { background: linear-gradient(145deg, #153b32 0%, #275348 100%); border-radius: 36rpx; box-shadow: 0 18rpx 36rpx rgba(21,65,55,.12); margin-top: 20rpx; padding: 36rpx; }
.hero-title { margin: 16rpx 0; font-size: 48rpx; line-height: 1.16; font-weight: 800; }
